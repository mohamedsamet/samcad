# =============================================================================
# SamCAD configuration template
# =============================================================================
# Copy this file to `config/samcad.env` to override the built-in defaults.
#
#   cp config/samcad.env.template config/samcad.env
#
# The app looks for `config/samcad.env` relative to the working directory.
# The file is optional: any missing key (or the whole file) falls back to the
# default value shown below.
#
# Syntax
#   - One `KEY=VALUE` per line.
#   - Lines starting with `#` are comments.
#   - Blank lines are ignored.
#   - Unknown keys are ignored, so this file stays forward-compatible.
#
# =============================================================================
# Graphics
# =============================================================================

# Color of the sticky-snap indicator circle drawn when the cursor locks onto
# an existing point (or other snap target).
#   Format : r,g,b or r,g,b,a with each channel 0-255
#   Default: 255,165,0 (orange)
#   Example: SNAP_INDICATOR_COLOR=0,255,0        # green
#            SNAP_INDICATOR_COLOR=255,0,0,128    # semi-transparent red
SNAP_INDICATOR_COLOR=255,165,0

# Color used for highlighted / selected UI elements (tool buttons, menus...).
#   Format : r,g,b or r,g,b,a with each channel 0-255
#   Default: 0,120,215 (blue)
#   Example: SELECTION_COLOR=173,216,230         # light blue
SELECTION_COLOR=0,120,215

# Color of drawn point markers on the canvas.
#   Format : r,g,b or r,g,b,a with each channel 0-255
#   Default: 255,255,255 (white)
#   Example: POINT_COLOR=255,0,0                 # red markers
POINT_COLOR=255,255,255

# Radius of a drawn point marker, in pixels.
#   Format : positive number (float allowed)
#   Default: 2.0
#   Example: POINT_RADIUS=4.5
POINT_RADIUS=2.0
